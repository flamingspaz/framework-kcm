# Maintainer: Yousef <github-viral8565@pxdmail.com>
#
# Built by CI from a `git archive` tarball placed next to this file
# (see .github/workflows/build.yml). CI also fills in pkgver and url.

pkgbase=framework-settings
pkgname=('framework-settings' 'framework-gui' 'framework-kcm' 'frameworkd')
pkgdesc='Framework laptop settings packages'
pkgver=0.1.2
pkgrel=1
arch=('x86_64')
url='https://github.com/OWNER/framework-kcm'
license=('GPL-3.0-or-later')
makedepends=(
  'cmake'
  'extra-cmake-modules'
  'git'
  'hidapi'
  'kcmutils'
  'kcoreaddons'
  'ki18n'
  'kirigami'
  'libusb'
  'qt6-base'
  'qt6-declarative'
  'rust'
  'systemd-libs'
)
options=('!lto')
source=("$pkgbase-$pkgver.tar.gz")
sha256sums=('SKIP')

# GCC LTO objects from hidapi's bundled C code can't be read by the linker cargo uses.
build() {
  export CARGO_HOME="$srcdir/cargo-home"
  cmake -B build -S "$pkgbase-$pkgver" \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_KCM=ON \
    -DBUILD_GUI=ON \
    -DBUILD_DAEMON=ON
  cmake --build build
}

package_framework-settings() {
  pkgdesc='Meta package for Framework laptop settings'
  depends=('framework-gui' 'framework-kcm' 'frameworkd')
  DESTDIR="$pkgdir" cmake --install build --component meta
  install -Dm644 "$pkgbase-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/framework-settings/LICENSE"
}

package_framework-gui() {
  pkgdesc='Standalone Qt settings application for Framework laptops'
  depends=('frameworkd' 'hicolor-icon-theme' 'qt6-base' 'qt6-declarative')
  DESTDIR="$pkgdir" cmake --install build --component gui
  install -Dm644 "$pkgbase-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/framework-gui/LICENSE"
}

package_framework-kcm() {
  pkgdesc='KDE System Settings module for Framework laptops'
  depends=('frameworkd' 'hicolor-icon-theme' 'kcmutils' 'kcoreaddons' 'ki18n' 'kirigami' 'qt6-base' 'qt6-declarative')
  DESTDIR="$pkgdir" cmake --install build --component kcm
  install -Dm644 "$pkgbase-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/framework-kcm/LICENSE"
}

package_frameworkd() {
  pkgdesc='System service for Framework laptop hardware settings'
  provides=('framework-kcmd')
  replaces=('framework-kcmd')
  depends=('dbus' 'hidapi' 'libusb' 'polkit' 'systemd-libs')
  install=frameworkd.install
  DESTDIR="$pkgdir" cmake --install build --component frameworkd
  install -Dm644 "$pkgbase-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/frameworkd/LICENSE"
}
