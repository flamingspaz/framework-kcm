#!/bin/sh
set -e

if [ "$1" = "configure" ] && [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
    # Pick up the new bus policy
    systemctl reload dbus || true
    # Started at boot so write-only settings get re-applied
    systemctl enable frameworkd.service || true
    systemctl restart frameworkd.service || true
fi
